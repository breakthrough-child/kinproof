    "record:demo": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/record-demo.ts",
    "compose:demo": "bash scripts/compose-demo.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.32.0",
