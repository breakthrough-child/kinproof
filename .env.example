# ---- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000     # public origin; used for PayPal redirect + SMS links
DEMO_MODE=true                                # shows one-click demo sign-in buttons. Turn off for real users.
DEMO_PASSWORD=                                # sandbox-only password for the seeded demo users (used by `pnpm seed:demo` and demo sign-in)
CRON_SECRET=                                  # any long random string; Vercel Cron sends it as a Bearer token to /api/cron/expire

# ---- Supabase (leave empty for local in-memory dev/tests) -------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                    # server only. Never expose to the browser.

# ---- PayPal (SANDBOX only) --------------------------------------------------
PAYPAL_MODE=mock                              # sandbox | mock   (deployed demo must be sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                            # optional; app works without webhooks
NEXT_PUBLIC_PAYPAL_CLIENT_ID=                 # same value as PAYPAL_CLIENT_ID (used by the PayPal JS SDK)

# ---- AI ---------------------------------------------------------------------
# Which LLM does the scam-pressure analysis. Safety rules are identical for every provider.
#   gemini    (default) Google Gemini via @google/genai. Needs GEMINI_API_KEY.
#   anthropic Claude. To switch later, set ONLY LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY.
#   mock      no LLM at all: deterministic rules engine + templated explanation (dev/tests only).
# If the selected provider has no key or fails, Kinproof falls back to rules-only and never auto-releases.
LLM_PROVIDER=gemini
GEMINI_API_KEY=                               # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-latest              # alias for the current Flash model; pin an exact model id for reproducibility
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Speech-to-text for voice notes.
#   gemini (default) audio sent inline to GEMINI_MODEL; reuses GEMINI_API_KEY.
#   groq   Whisper via Groq (GROQ_API_KEY)     openai  Whisper via OpenAI (OPENAI_API_KEY)
# Gemini accepts WAV/MP3/AIFF/AAC/OGG/FLAC; .opus/.m4a/.webm are converted (in the browser to WAV, or with ffmpeg on the server).
TRANSCRIBE_PROVIDER=gemini
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- Tuning -----------------------------------------------------------------
CONFIRM_WINDOW_MINUTES=15                     # how long the real person has to answer
AUTO_RELEASE_MAX=200                          # low-risk transfers under this (USD) to a verified payee skip confirmation
NGN_DISPLAY_RATE=1550                         # display only, approximate
OVERRIDE_COOLDOWN_MINUTES=10                  # cooling-off before "send anyway" when nobody can confirm
HIGH_AMOUNT_NO_HISTORY=300                    # USD; amount rule threshold when the sender has no history

# ---- Optional SMS (link only, never reply-to-approve) -----------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Seeded sandbox accounts (emails only, never passwords) -----------------
DEMO_ADA_PAYPAL_EMAIL=                        # sandbox PERSONAL (buyer) account Ada pays from
DEMO_CHIDI_PAYPAL_EMAIL=                      # sandbox PERSONAL account that receives from Ada
DEMO_NGOZI_PAYPAL_EMAIL=
DEMO_HOSPITAL_PAYPAL_EMAIL=                   # sandbox BUSINESS accounts
DEMO_SCHOOL_PAYPAL_EMAIL=
DEMO_LEGAL_PAYPAL_EMAIL=
DEMO_FIGURE_PAYPAL_EMAIL=
